# Copy to .env and fill in. `.env` is gitignored.

# Tailscale logins allowed to use the app (comma-separated).
# Find yours with `tailscale whois $(tailscale ip -4)` or in the Tailscale admin console.
ALLOWED_LOGINS=you@example.com

# Your home folder on the host. It is mounted at the same path inside the
# container, so ~/.gitconfig, ~/.ssh and file paths match the host.
HOST_HOME=/home/you

# Folders the app may read and write (comma-separated). Everything else is off limits.
# Each one must be inside HOST_HOME or /mnt, the only host folders the container sees.
ALLOWED_ROOTS=/home/you

# Your user and group IDs on the host (`id -u`, `id -g`), so files the app
# writes are owned by you.
PUID=1000
PGID=1000

# Host port. Open http://<tailscale-ip>:PORT on the phone.
PORT=7777

# Timezone for daily notes and capture timestamps.
TZ=UTC

# Only for local development: also trust requests from 127.0.0.1.
DEV_TRUST_LOCAL=false
